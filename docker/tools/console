#!/bin/sh

RUN_DIR="/var/run/tarantool/sys_env"
APP_NAME="${TT_APP_NAME-default}"
INSTANCE_NAME="${TT_INSTANCE_NAME-instance-001}"
SOCKET="${RUN_DIR}/${APP_NAME}/${INSTANCE_NAME}/tarantool.control"
TT_CONSOLE_SOCKET_DEFAULT="${TT_CONSOLE_SOCKET_DEFAULT-${SOCKET}}"
tt connect "${TT_CONSOLE_SOCKET:-${TT_CONSOLE_SOCKET_DEFAULT}}"
